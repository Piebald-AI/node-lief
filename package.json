{
  "name": "node-lief",
  "version": "1.3.1",
  "description": "Node.js bindings for LIEF, a library to parse and manipulate ELF, PE, and Mach-O executables.",
  "keywords": [
    "binary",
    "dwarf",
    "elf",
    "executable",
    "macho",
    "parsing",
    "pdb",
    "pe"
  ],
  "license": "Apache-2.0",
  "author": "Piebald LLC <support@piebald.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Piebald-AI/node-lief"
  },
  "files": [
    "lib/",
    "prebuilds/",
    "NOTICE"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm build:lief && node-gyp rebuild",
    "build:lief": "node scripts/build-lief.js",
    "clean": "rm -rf build",
    "prebuildify": "prebuildify --napi --strip",
    "test": "node --test test/**/*.test.js",
    "coverage": "./scripts/coverage.sh",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "node-addon-api": "github:legendecas/node-addon-api#a438147a58e46b68bcf90eed10fd68aadb9d3c9b",
    "node-gyp": "^13.0.1",
    "node-gyp-build": "^4.8.4",
    "oxfmt": "^0.60.0",
    "prebuildify": "^6.0.1",
    "typescript": "^7.0.2"
  }
}
